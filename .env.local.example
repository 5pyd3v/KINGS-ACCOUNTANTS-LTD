# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. .env.local is git-ignored — never commit it.
# ---------------------------------------------------------------------------

# MongoDB connection string.
#
# Standard Atlas SRV form (preferred):
#   MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/kings-accountants?retryWrites=true&w=majority
#
# NOTE: mongodb+srv:// needs Node's c-ares DNS resolver. If you hit
# "querySrv ECONNREFUSED", Node's resolver cannot reach a DNS server
# (check `node -e "console.log(require('dns').getServers())"`). In that case use
# the direct form listing the shard hosts, which uses the system resolver:
#   MONGODB_URI=mongodb://<user>:<pass>@host1:27017,host2:27017,host3:27017/kings-accountants?ssl=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=

# NextAuth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Optional: creates/updates the first admin login when running `npm run seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
